# Automatic HTTPS (Let's Encrypt) for the site and the API.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

api.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8080 {
		# Server-sent events: pass bytes through as they come.
		flush_interval -1
	}
}
