# syntax=docker/dockerfile:1.7
# The Next.js site. NEXT_PUBLIC_* values are baked in at build time, so they are build args.
FROM node:24-alpine AS build
WORKDIR /repo
COPY package.json package-lock.json tsconfig.json ./
COPY packages packages
COPY apps apps
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_RPC_URL
ARG NEXT_PUBLIC_CHAIN_ID
ARG NEXT_PUBLIC_CHAIN_NAME
ARG NEXT_PUBLIC_EXPLORER_URL
ARG NEXT_PUBLIC_PRELAUNCH
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL \
    NEXT_PUBLIC_CHAIN_ID=$NEXT_PUBLIC_CHAIN_ID \
    NEXT_PUBLIC_CHAIN_NAME=$NEXT_PUBLIC_CHAIN_NAME \
    NEXT_PUBLIC_EXPLORER_URL=$NEXT_PUBLIC_EXPLORER_URL \
    NEXT_PUBLIC_PRELAUNCH=$NEXT_PUBLIC_PRELAUNCH
RUN npm run build -w @sealdesk/web

FROM node:24-alpine
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
RUN apk add --no-cache tini
WORKDIR /repo
COPY --from=build /repo /repo
USER node
WORKDIR /repo/apps/web
EXPOSE 3000
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["npx", "next", "start", "-p", "3000", "-H", "0.0.0.0"]
