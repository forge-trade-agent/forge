# Copied to deploy/.env.prod on the server by setup.sh, which fills in the secrets.
DOMAIN=forgetrade.sbs

# --- chain: Robinhood Chain mainnet (markets + prices are real) ---
CHAIN_ID=4663
CHAIN_NAME=Robinhood Chain
RPC_URLS=https://rpc.mainnet.chain.robinhood.com
PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXPLORER_URL=https://robinhoodchain.blockscout.com
STABLE_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
STABLE_DECIMALS=6

# --- pre-launch: no contracts yet. Set the real addresses and PRELAUNCH=0 at launch ---
PRELAUNCH=1
ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
VAULT_ADDRESS=0x0000000000000000000000000000000000000000
PLATFORM_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
ESCROW_DEPLOY_BLOCK=0

# --- api ---
API_PORT=8080
API_PUBLIC_URL=https://api.forgetrade.sbs
CORS_ORIGINS=https://forgetrade.sbs,https://www.forgetrade.sbs
NOTIFY_CHANNELS=webhook
LOG_LEVEL=info

# --- secrets (setup.sh generates these) ---
POSTGRES_PASSWORD=
NOTIFY_ENCRYPTION_KEY=
ADMIN_TOKEN=

# --- optional ---
ALPHAVANTAGE_API_KEY=
# RELAYER_PRIVATE_KEY=   (only with --profile launch; a fresh hot wallet, never your main key)
